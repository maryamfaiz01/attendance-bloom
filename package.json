{
  "name": "system-group-project",
  "version": "1.0.0",
  "description": "Student Attendance Management System for Thondaman Vocational Training Centre",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "dev:https": "node -e \"process.env.USE_HTTPS='true'; require('./server/server.js')\"",
    "seed": "node server/db/seed.js",
    "reset-admin": "node server/db/resetAdmin.js",
    "test": "node --test server/tests/auth.test.js server/tests/attendance.test.js server/tests/students.test.js"
  },
  "keywords": [
